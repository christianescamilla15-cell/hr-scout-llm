# Copy to .env and fill in. Never commit .env.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Dev: sqlite local for fast iteration
DATABASE_URL=sqlite+aiosqlite:///./hrscout_dev.db
# Prod: Render Postgres (the backend auto-normalizes postgres:// to postgresql+asyncpg://)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Auth (Phase 1 Day 2) ---
JWT_SECRET=change-me-to-32-bytes-random
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8004/api/auth/google/callback

# --- LLM (Phase 1 Day 4) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Stripe (Phase 1 Day 6) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# --- Email (Phase 1 Day 10) ---
RESEND_API_KEY=

# --- PII encryption at rest (Fernet, AES-128 + HMAC) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3004,https://hr-scout-llm.vercel.app
