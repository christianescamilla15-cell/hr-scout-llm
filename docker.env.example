# Copy to .env.docker and fill in. Never commit .env.docker.
#
# Used by docker-compose for local staging. Production keys live in
# Render env vars (set during deploy via scripts).

# Ports (override if you have other things running)
BACKEND_PORT=8004
FRONTEND_PORT=3004
POSTGRES_PORT=5433

# Postgres
POSTGRES_USER=hrscout
POSTGRES_PASSWORD=hrscout_dev_only
POSTGRES_DB=hrscout

# Auth — these must be REAL to test Google login flow against the docker stack
JWT_SECRET=docker-dev-only-3a7f9c2e8d1b5a4f6e9c8d2b7a3f1e5c8d4b9a7f3e1c5d8b2a6f9e4c7d1b5a8f
FERNET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM — only Groq is wired for now
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Stripe — leave empty to keep billing in degraded mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# SonarQube (only needed when running `--profile sonar-scan`)
SONAR_TOKEN=
